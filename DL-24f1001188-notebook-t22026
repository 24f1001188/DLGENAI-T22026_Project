    "def retrieve_documents(prompt, k=5):\n",
    "    \"\"\"\n",
    "    Retrieve the top-k most similar documents from the knowledge base.\n",
    "    \"\"\"\n",
    "\n",
    "    prompt_embedding = embedding_model.encode(\n",
    "        [prompt],\n",
    "        convert_to_numpy=True\n",
    "    )\n",
    "\n",
    "    distances, indices = index.search(prompt_embedding, k)\n",
    "\n",
    "    retrieved_docs = [kb[i] for i in indices[0]]\n",
    "\n",
    "    return retrieved_docs, indices[0], distances[0]"
