mbined_text = (\n        train_df[\"prompt\"] + \" \" +\n        train_df[\"A\"] + \" \" +\n        train_df[\"B\"] + \" \" +\n        train_df[\"C\"] + \" \" +\n        train_df[\"D\"] + \" \" +\n        train_df[\"E\"]\n    )\n\n    vectorizer = TfidfVectorizer(stop_words=\"english\")\n    vectorizer.fit(combined_text)\n\n    return vectorizer","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-04T15:02:36.216028Z","iopub.execute_input":"2026-08-04T15:02:36.216257Z","iopub.status.idle":"2026-08-04T15:02:36.227260Z","shell.execute_reply.started":"2026-08-04T15:02:36.216192Z","shell.execute_reply":"2026-08-04T15:02:36.226660Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"tfidf_vectorizer = build_tfidf_vectorizer(train_df)\nprint(\"TF-IDF vocabulary size:\", len(tfidf_vectorizer.vocabulary_))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-04T15:02:36.228188Z","iopub.execute_input":"2026-08-04T15:02:36.228461Z","iopub.status.idle":"2026-08-04T15:02:36.373767Z","shell.execute_reply.started":"2026-08-04T15:02:36.228436Z","shell.execute_reply":"2026-08-04T15:02:36.373115Z"}},"outputs":[{"name":"stdout","text":"TF-IDF vocabulary size: 2865\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"def predict_tfidf_top3(df, vectorizer):\n    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    predictions = []\n    \n    for _, row in df.iterrows():\n        prompt_vec = vectorizer.transform([row[\"prompt\"]])\n        \n        similarities = {}\n        \n        for opt in options:\n            option_vec = vectorizer.transform([row[opt]])\n            sim = cosine_similarity(prompt_vec, option_vec)[0][0]\n            similarities[opt] = sim\n        \n        sorted_options = sorted(similarities, key=similarities.get, reverse=True)\n        predictions.append(sorted_options[:3])\n    \n    return predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-04T15:02:3