    "def evaluate_mcq_model(y_true, top3_predictions, model_name):\n",
    "    \"\"\"\n",
    "    Evaluate Top-3 predictions at the final 5-class MCQ level.\n",
    "    \"\"\"\n",
    "\n",
    "    # Extract highest-ranked answer\n",
    "    y_pred = [pred[0] for pred in top3_predictions]\n",
    "\n",
    "    return {\n",
    "        \"Model\": model_name,\n",
    "        \"Accuracy\": accuracy_score(y_true, y_pred),\n",
    "        \"Macro Precision\": precision_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ),\n",
    "        \"Macro Recall\": recall_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        ),\n",
    "        \"Macro F1\": f1_score(\n",
    "            y_true, y_pred, average=\"macro\", zero_division=0\n",
    "        )\n",
    "    }"
   ]
