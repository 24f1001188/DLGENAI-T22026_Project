    "# ==========================================================\n",
    "# Build BiLSTM Model\n",
    "# ==========================================================\n",
    "\n",
    "\n",
    "\n",
    "EMBEDDING_DIM = 64\n",
    "\n",
    "model = Sequential([\n",
    "    \n",
    "    # Convert text to integer tokens\n",
    "    vectorizer,\n",
    "\n",
    "    # Learn word embeddings\n",
    "    Embedding(\n",
    "    input_dim=len(vectorizer.get_vocabulary()),\n",
    "    output_dim=EMBEDDING_DIM,\n",
    "    mask_zero=True\n",
    "),\n",
    "\n",
    "    # Bidirectional LSTM\n",
    "    Bidirectional(\n",
    "        LSTM(64, return_sequences=True)\n",
    "    ),\n",
    "\n",
    "    # Keep the strongest features\n",
    "    GlobalMaxPooling1D(),\n",
    "\n",
    "    # Reduce overfitting\n",
    "    Dropout(0.30),\n",
    "\n",
    "    # Dense hidden layer\n",
    "    Dense(32, activation=\"relu\"),\n",
    "\n",
    "    # Binary classification\n",
    "    Dense(1, activation=\"sigmoid\")\n",
    "])\n",
    "\n",
    "dummy_input = tf.constant([\"This is a sample sentence.\"])\n",
    "_ = model(dummy_input)\n",
    "model.summary()"
