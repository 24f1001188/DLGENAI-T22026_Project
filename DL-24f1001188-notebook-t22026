    "# ==========================================================\n",
    "# Convert Scores to Ranked Predictions\n",
    "# ==========================================================\n",
    "\n",
    "options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "\n",
    "bilstm_predictions = []\n",
    "\n",
    "for i in range(0, len(bilstm_scores), 5):\n",
    "\n",
    "    scores = bilstm_scores[i:i+5]\n",
    "\n",
    "    ranked = np.argsort(scores)[::-1]\n",
    "\n",
    "    prediction = [options[idx] for idx in ranked]\n",
    "\n",
    "    bilstm_predictions.append(prediction)"
