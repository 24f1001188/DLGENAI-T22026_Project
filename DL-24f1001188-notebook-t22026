 Probabilities\n# ==========================================================\n\ntest_pairs_tf = tf.constant(test_pairs, dtype=tf.string)\n\nbilstm_scores = model.predict(\n    test_pairs_tf,\n    batch_size=32,\n    verbose=1\n)\n\nbilstm_scores = bilstm_scores.flatten()\n\nprint(\"Total scores:\", len(bilstm_scores))\nprint(\"First 5 scores:\", bilstm_scores[:5])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-21T09:15:31.866928Z","iopub.execute_input":"2026-07-21T09:15:31.867383Z","iopub.status.idle":"2026-07-21T09:15:32.916657Z","shell.execute_reply.started":"2026-07-21T09:15:31.867354Z","shell.execute_reply":"2026-07-21T09:15:32.915646Z"}},"outputs":[{"name":"stdout","text":"\u001b[1m79/79\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m1s\u001b[0m 9ms/step\nTotal scores: 2500\nFirst 5 scores: [9.9651515e-01 3.2238047e-05 2.7862547e-05 3.2409931e-05 4.0746574e-05]\n","output_type":"stream"}],"execution_count":67},{"cell_type":"markdown","source":"## Generating Final Submission\n\nThe BiLSTM model predicts a probability for each question-option pair independently.\n\nFor every question:\n\n1. Five probabilities are obtained, one for each option (A–E).\n2. The probabilities are sorted in descending order.\n3. The corresponding option labels are arranged from the highest to the lowest probability.\n4. The ordered option labels form the final prediction required by the competition.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Convert Scores to Ranked Predictions\n# ==========================================================\n\noptions = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\nbilstm_predictions = []\n\nfor i in range(0, len(bilstm_scores), 5):\n\n    scores = bilstm_scores[i:i+5]\n\n    ranked = np.argsort(scores)[::-1]\n\n    prediction = \" \".join([options[idx] for idx in ranked])\n\n    bilstm_predictions.append(prediction)\n\nprint(\"Number of predi