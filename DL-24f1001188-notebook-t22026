    "def retrieve_documents(prompt, k=5):\n",
    "    \"\"\"\n",
    "    Retrieve the top-k most similar documents from the knowledge base.\n",
    "    \"\"\"\n",
    "\n",
    "    prompt_embedding = embedding_model.encode(\n",
