    "def clean_question(question):\n",
    "    question = question.lower()\n",
    "\n",
    "    question = question.replace(\"pick the best possible answer\", \"\")\n",
    "    question = question.replace(\"among the listed options\", \"\")\n",
    "\n",
    "    return \" \".join(question.split())\n",
    "\n",
    "# Rebuild the BiLSTM dataset\n",
    "bilstm_data = []\n",
    "\n",
    "for _, row in train.iterrows():\n",
    "\n",
    "    question = clean_question(str(row[\"prompt\"]))\n",
    "\n",
    "    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n",
    "\n",
    "        bilstm_data.append({\n",
    "            \"text\": question + \" [SEP] \" + str(row[option]),\n",
    "            \"label\": 1 if option == row[\"answer\"] else 0\n",
    "        })\n",
    "\n",
    "bilstm_df = pd.DataFrame(bilstm_data)\n",
