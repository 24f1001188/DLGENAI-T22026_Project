    "def predict_tfidf_top3(df, vectorizer):\n",
    "    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    predictions = []\n",
    "    \n",
    "    for _, row in df.iterrows():\n",
    "        prompt_vec = vectorizer.transform([row[\"prompt\"]])\n",
    "        \n",
    "        similarities = {}\n",
    "        \n",
    "        for opt in options:\n",
    "            option_vec = vectorizer.transform([row[opt]])\n",
    "            sim = cosine_similarity(prompt_vec, option_vec)[0][0]\n",
    "            similarities[opt] = sim\n",
    "        \n",
    "        sorted_options = sorted(similarities, key=similarities.get, reverse=True)\n",
    "        predictions.append(sorted_options[:3])\n",
    "    \n",
    "    return predictions"
   ]
  },
