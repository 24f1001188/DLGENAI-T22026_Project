    "def predict_zero_shot_top3(df, classifier):\n",
    "\n",
    "    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    predictions = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "\n",
    "        prompt = str(row[\"prompt\"])\n",
    "\n",
    "        labels = [\n",
    "            str(row[\"A\"]),\n",
    "            str(row[\"B\"]),\n",
    "            str(row[\"C\"]),\n",
    "            str(row[\"D\"]),\n",
    "            str(row[\"E\"])\n",
    "        ]\n",
    "\n",
    "        result = classifier(\n",
    "            prompt,\n",
    "            candidate_labels=labels\n",
    "        )\n",
    "\n",
    "        predicted_letters = []\n",
    "\n",
    "        for predicted_label in result[\"labels\"][:3]:\n",
    "            for option in options:\n",
    "                if predicted_label == str(row[option]):\n",
    "                    predicted_letters.append(option)\n",
    "                    break\n",
    "\n",
    "        predictions.append(predicted_letters)\n",
    "\n",
    "    return predictions"
   ]
  },
