    "    scores = cross_encoder.predict(pairs)\n",
    "\n",
    "    ranked_indices = np.argsort(scores)[::-1]\n",
    "\n",
    "    reranked_docs = [retrieved_docs[i] for i in ranked_indices]\n",
    "\n",
    "    return reranked_docs, scores[ranked_indices]"
   ]
