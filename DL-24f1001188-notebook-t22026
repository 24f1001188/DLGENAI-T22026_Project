 for rank, option in enumerate(r_pred):\n            scores[option] += rag_weight * (3 - rank)\n\n        ranked = sorted(\n            options,\n            key=lambda x: scores[x],\n            reverse=True\n        )\n\n        ensemble_predictions.append(ranked[:3])\n\n    return ensemble_predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.259825Z","iopub.status.idle":"2026-07-30T16:23:18.260161Z","shell.execute_reply.started":"2026-07-30T16:23:18.260026Z","shell.execute_reply":"2026-07-30T16:23:18.260050Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"ensemble_val_predictions = weighted_rank_ensemble(\n    bilstm_val_predictions,\n    transformer_val_predictions,\n    rag_val_predictions,\n    bilstm_weight=0.45,\n    transformer_weight=0.35,\n    rag_weight=0.20\n)\n\nensemble_map3 = map3_score(\n    val_df[\"answer\"],\n    ensemble_val_predictions\n)\n\nprint(f\"Ensemble MAP@3: {ensemble_map3:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.261575Z","iopub.status.idle":"2026-07-30T16:23:18.261826Z","shell.execute_reply.started":"2026-07-30T16:23:18.261719Z","shell.execute_reply":"2026-07-30T16:23:18.261732Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"results.loc[len(results)] = [\n    \"Weighted Ensemble\",\n    round(ensemble_map3, 4)\n]\n\nresults","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.263671Z","iopub.status.idle":"2026-07-30T16:23:18.264000Z","shell.execute_reply.started":"2026-07-30T16:23:18.263835Z","shell.execute_reply":"2026-07-30T16:23:18.263854Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"ensemble_predictions = weighted_rank_ensemble(\n    bilstm_predictions,\n    transformer_test_predictions,\n    rag_test_predictions\n    \n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.265483Z","iopub.status.idle":"2026-07-30T1