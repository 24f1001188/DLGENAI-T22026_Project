 = row[\"prompt\"]\n\n        # Retrieve documents\n        retrieved_docs, _, _ = retrieve_documents(prompt, k=5)\n\n        # Rerank documents\n        reranked_docs, _ = rerank_documents(prompt, retrieved_docs)\n\n        # Best document\n        best_document = reranked_docs[0]\n\n        # Create RAG prompt\n        rag_prompt = f\"Context: {best_document} Question: {prompt}\"\n\n        candidate_labels = [\n            row[\"A\"],\n            row[\"B\"],\n            row[\"C\"],\n            row[\"D\"],\n            row[\"E\"]\n        ]\n\n        result = zs(\n            rag_prompt,\n            candidate_labels,\n            multi_label=False\n        )\n\n        option_map = {\n            row[option]: option\n            for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]\n        }\n\n        top3 = [\n            option_map[label]\n            for label in result[\"labels\"][:3]\n        ]\n\n        predictions.append(top3)\n\n    return predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-21T09:04:15.267094Z","iopub.execute_input":"2026-07-21T09:04:15.267463Z","iopub.status.idle":"2026-07-21T09:04:15.273209Z","shell.execute_reply.started":"2026-07-21T09:04:15.267441Z","shell.execute_reply":"2026-07-21T09:04:15.272634Z"}},"outputs":[],"execution_count":44},{"cell_type":"code","source":"rag_predictions = predict_rag_top3(\n    train.head(5),\n    embedding_model\n)\n\nrag_predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-21T09:04:15.274159Z","iopub.execute_input":"2026-07-21T09:04:15.274421Z","iopub.status.idle":"2026-07-21T09:04:16.34903Z","shell.execute_reply.started":"2026-07-21T09:04:15.274399Z","shell.execute_reply":"2026-07-21T09:04:16.348301Z"}},"outputs":[{"execution_count":45,"output_type":"execute_result","data":{"text/plain":"[['B', 'C', 'E'],\n ['A', 'E', 'D'],\n ['C', 'B', 'E'],\n ['B', 'E', 'C'],\n ['A', 'B', 'C']]"},"metadata":{}}],"execution_count":45},{"cell_type":"code","so