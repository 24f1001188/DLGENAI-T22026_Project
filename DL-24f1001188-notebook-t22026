    "# ==========================================================\n",
    "# Predict Validation Option Probabilities\n",
    "# ==========================================================\n",
    "\n",
    "val_pairs = []\n",
    "\n",
    "for _, row in val_df.iterrows():\n",
    "\n",
    "    prompt = clean_question(str(row[\"prompt\"]))\n",
    "\n",
    "    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n",
    "        val_pairs.append(\n",
    "            prompt + \" [SEP] \" + str(row[option])\n",
    "        )\n",
    "\n",
    "val_pairs = np.array(val_pairs)\n",
    "\n",
    "val_pairs_tf = tf.constant(val_pairs, dtype=tf.string)\n",
    "\n",
    "val_scores = model.predict(\n",
    "    val_pairs_tf,\n",
    "    batch_size=32,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "val_scores = val_scores.flatten()\n",
    "\n",
    "# Convert scores into rankings\n",
    "val_rankings = []\n",
    "\n",
    "for i in range(0, len(val_scores), 5):\n",
    "\n",
    "    scores = val_scores[i:i+5]\n",
    "\n",
    "    ranked = np.argsort(scores)[::-1]\n",
    "\n",
    "    val_rankings.append(ranked)"
