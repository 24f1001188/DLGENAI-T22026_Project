    "# ==========================================================\n",
    "# Build BiLSTM Dataset\n",
    "# ==========================================================\n",
    "\n",
    "def build_bilstm_dataset(df):\n",
    "    bilstm_data = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "\n",
