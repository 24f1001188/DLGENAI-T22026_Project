    "def predict_rag_top3(df, embedding_model):\n",
    "    \"\"\"\n",
    "    Predict top-3 answer choices using the complete RAG pipeline.\n",
    "    \"\"\"\n",
    "\n",
    "    predictions = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "\n",
    "        prompt = row[\"prompt\"]\n",
    "\n",
    "        # Retrieve documents\n",
    "        retrieved_docs, _, _ = retrieve_documents(prompt, k=5)\n",
    "\n",
    "        # Rerank documents\n",
    "        reranked_docs, _ = rerank_documents(prompt, retrieved_docs)\n",
    "\n",
    "        # Best document\n",
    "        best_document = reranked_docs[0]\n",
    "\n",
    "        # Create RAG prompt\n",
    "        rag_prompt = f\"Context: {best_document} Question: {prompt}\"\n",
    "\n",
    "        candidate_labels = [\n",
    "            row[\"A\"],\n",
    "            row[\"B\"],\n",
    "            row[\"C\"],\n",
    "            row[\"D\"],\n",
    "            row[\"E\"]\n",
    "        ]\n",
    "\n",
    "        result = zs(\n",
    "            rag_prompt,\n",
    "            candidate_labels,\n",
    "            multi_label=False\n",
    "        )\n",
    "\n",
    "        option_map = {\n",
    "            row[option]: option\n",
    "            for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "        }\n",
    "\n",
    "        top3 = [\n",
    "            option_map[label]\n",
    "            for label in result[\"labels\"][:3]\n",
    "        ]\n",
    "\n",
    "        predictions.append(top3)\n",
    "\n",
    "    return predictions"
   ]
  },
