"2026-07-30T16:23:18.210525Z","shell.execute_reply":"2026-07-30T16:23:18.210586Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"X_train = bilstm_train_df[\"text\"]\ny_train = bilstm_train_df[\"label\"]\n\nX_val = bilstm_val_df[\"text\"]\ny_val = bilstm_val_df[\"label\"]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.211813Z","iopub.status.idle":"2026-07-30T16:23:18.212079Z","shell.execute_reply.started":"2026-07-30T16:23:18.211936Z","shell.execute_reply":"2026-07-30T16:23:18.211974Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Hyperparameter Analysis for BiLSTM","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Hyperparameter Analysis\n# ==========================================================\n\n# Number of words in each sample\nword_counts = bilstm_train_df[\"text\"].apply(lambda x: len(str(x).split()))\n\nprint(\"=\"*50)\nprint(\"TEXT LENGTH ANALYSIS\")\nprint(\"=\"*50)\n\nprint(f\"Number of samples        : {len(word_counts)}\")\nprint(f\"Average length           : {word_counts.mean():.2f} words\")\nprint(f\"Median length            : {word_counts.median():.0f} words\")\nprint(f\"Maximum length           : {word_counts.max()} words\")\nprint(f\"95th Percentile Length   : {np.percentile(word_counts,95):.0f} words\")\nprint(f\"99th Percentile Length   : {np.percentile(word_counts,99):.0f} words\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"VOCABULARY ANALYSIS\")\nprint(\"=\"*50)\n\nall_words = \" \".join(bilstm_train_df[\"text\"]).lower().split()\n\nvocab_counter = Counter(all_words)\n\nprint(f\"Total words              : {len(all_words):,}\")\nprint(f\"Unique words             : {len(vocab_counter):,}\")\n\nprint(\"\\nTop 20 most common words:\\n\")\n\nfor word, freq in vocab_counter.most_common(20):\n    print(f\"{word:20s} {freq}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.213130Z","iopub.status.idle":"2026-07-30T16:23:18.213756Z","shell.execute_reply.started":"2026-07-30T16:23:18.213623Z","shell.execute_reply":"2026-07-30T16:23:18.213640Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Hyperparameter selection was based on dataset statistics rather than arbitrary values. The sequence length analysis showed that 95% of the samples contained 82 words or fewer and 99% contained 103 words or fewer. Therefore, a maximum sequence length of 128 was selected to preserve nearly all samples while maintaining computational efficiency. Vocabulary analysis revealed approximately 3,100 unique words in the dataset. Consequently, the vocabulary size was limited to 3,500, which covers the complete vocabulary while reducing unnecessary model parameters and memory usage.","metadata":{}},{"cell_type":"markdown","source":"For the BiLSTM model, natural sentence structure was preserved by retaining stopwords, as recurrent neural networks benefit from contextual information. Only fixed instructional phrases that appeared identically in every sample (e.g., \"pick the best possible answer\" and \"among the listed options\") were removed because they do not contribute to distinguishing the correct answer and introduce unnecessary noise.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Text Vectorization\n# ==========================================================\n\n\nVOCAB_SIZE = 3500\nMAX_LENGTH = 128\n\nvectorizer = TextVectorization(\n    max_tokens=VOCAB_SIZE,\n    output_mode=\"int\",\n    output_sequence_length=MAX_LENGTH\n)\n\n# Learn the vocabulary from the training data\nvectorizer.adapt(X_train)\n\nprint(\"=\"*50)\nprint(\"TEXT VECTORIZATION\")\nprint(\"=\"*50)\nprint(f\"Vocabulary learned : {len(vectorizer.get_vocabulary())}\")\nprint(f\"Maximum sequence length : {MAX_LENGTH}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.215149Z","iopub.status.idle":"2026-07-30T16:23:18.215483Z","shell.execute_reply.started":"2026-07-30T16:23:18.215370Z","shell.execute_reply":"2026-07-30T16:23:18.215384Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"The embedding dimension determines the size of the dense vector representing each word. Since the dataset contains only around 3,100 unique words and 10,000 training samples, a 64-dimensional embedding provides sufficient capacity to learn semantic relationships while keeping the number of trainable parameters low. Larger embeddings such as 128 or 300 would increase computational cost and the risk of overfitting without a clear benefit for this dataset.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Build BiLSTM Model\n# ==========================================================\n\n\n\nEMBEDDING_DIM = 64\n\nmodel = Sequential([\n    \n    # Convert text to integer tokens\n    vectorizer,\n\n    # Learn word embeddings\n    Embedding(\n    input_dim=len(vectorizer.get_vocabulary()),\n    output_dim=EMBEDDING_DIM,\n    mask_zero=True\n),\n\n    # Bidirectional LSTM\n    Bidirectional(\n        LSTM(64, return_sequences=True)\n    ),\n\n    # Keep the strongest features\n    GlobalMaxPooling1D(),\n\n    # Reduce overfitting\n    Dropout(0.30),\n\n    # Dense hidden layer\n    Dense(32, activation=\"relu\"),\n\n    # Binary classification\n    Dense(1, activation=\"sigmoid\")\n])\n\ndummy_input = tf.constant([\"This is a sample sentence.\"])\n_ = model(dummy_input)\nmodel.summary()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.216780Z","iopub.status.idle":"2026-07-30T16:23:18.217080Z","shell.execute_reply.started":"2026-07-30T16:23:18.216955Z","shell.execute_reply":"2026-07-30T16:23:18.216970Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Compile BiLSTM Model\n# ==========================================================\n\n\n\nmodel.compile(\n    optimizer=Adam(learning_rate=0.001),\n    loss=\"binary_crossentropy\",\n    metrics=[\n    \"accuracy\",\n    tf.keras.metrics.AUC(name=\"auc\")\n]\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.218596Z","iopub.status.idle":"2026-07-30T16:23:18.218860Z","shell.execute_reply.started":"2026-07-30T16:23:18.218748Z","shell.execute_reply":"2026-07-30T16:23:18.218761Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Model Compilation\n\nThe BiLSTM model was compiled using the **Adam optimizer**, **Binary Cross-Entropy loss function**, and **Accuracy** as the evaluation metric. These choices were made based on the nature of the dataset and the binary classification problem.\n\n### 1. Optimizer: Adam\n\nThe Adam (Adaptive Moment Estimation) optimizer was selected because it combines the advantages of Momentum and RMSProp. It automatically adapts the learning rate for each parameter, resulting in faster convergence and more stable training. Adam is widely used in Natural Language Processing tasks due to its efficiency and robustness.\n\n### 2. Learning Rate: 0.001\n\nA learning rate of **0.001** was chosen because it is the default and most commonly recommended value for the Adam optimizer. It provides a good balance between learning speed and training stability. Higher learning rates may cause unstable training, while lower values increase the training time without significant performance improvements for this dataset.\n\n### 3. Loss Function: Binary Cross-Entropy\n\nThe problem was formulated as a **binary classification** task, where each question-option pair is labelled as:\n\n- **1** → Correct answer\n- **0** → Incorrect answer\n\nSince the output layer consists of a single neuron with a **Sigmoid activation function**, Binary Cross-Entropy is the most appropriate loss function for measuring the prediction error.\n\n### 4. Evaluation Metrics: Accuracy and AUC\n\nTwo evaluation metrics were used during training:\n\n- **Accuracy** measures the percentage of correctly classified question-option pairs and provides an intuitive indication of the model's performance.\n- **AUC (Area Under the ROC Curve)** evaluates the model's ability to distinguish between the positive (correct answer) and negative (incorrect answer) classes across different classification thresholds. Unlike accuracy, AUC is less sensitive to the chosen decision threshold and provides a more comprehensive measure of classification performance.\n\nUsing both metrics allows the model to be evaluated from different perspectives, providing a more reliable assessment of its learning behaviour.\n\n### Summary\n\n| Hyperparameter | Selected Value | Justification |\n|----------------|---------------|---------------|\n| Optimizer | Adam | Fast convergence and adaptive learning rates for NLP tasks |\n| Learning Rate | 0.001 | Stable default value for Adam that balances speed and convergence |\n| Loss Function | Binary Cross-Entropy | Suitable for binary classification using Sigmoid output |\n| Evaluation Metric | Accuracy, AUC| Accuracy measures correct predictions, while AUC evaluates the model's discrimination ability across thresholds |","metadata":{}},{"cell_type":"markdown","source":"## Model Training\n\nThe model was trained using **EarlyStopping** and **ModelCheckpoint** callbacks to improve generalization and avoid unnecessary training.\n\n### 1. EarlyStopping\n\nThe EarlyStopping callback monitors the validation loss during training. If the validation loss does not improve for several consecutive epochs, the training process is stopped automatically. This helps prevent overfitting and reduces unnecessary computation.\n\nThe best model weights are restored automatically after training.\n\n### 2. ModelCheckpoint\n\nThe ModelCheckpoint callback saves the model whenever the validation loss improves. This ensures that the best-performing model is preserved, even if subsequent epochs lead to overfitting.\n\n### Training Configuration\n\n- Optimizer: Adam\n- Loss Function: Binary Cross-Entropy\n- Metrics: Accuracy and AUC\n- Batch Size: 32\n- Maximum Epochs: 10\n- EarlyStopping Patience: 2 epochs","metadata":{}},{"cell_type":"code","source":"# Convert text to NumPy string arrays\nX_train_tf = X_train.astype(str).to_numpy()\nX_val_tf = X_val.astype(str).to_numpy()\n\n# Convert labels to NumPy integer arrays\ny_train_tf = y_train.to_numpy(dtype=np.int32)\ny_val_tf = y_val.to_numpy(dtype=np.int32)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.220137Z","iopub.status.idle":"2026-07-30T16:23:18.220490Z","shell.execute_reply.started":"2026-07-30T16:23:18.220318Z","shell.execute_reply":"2026-07-30T16:23:18.220337Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"TensorFlow models were trained using NumPy arrays rather than Pandas Series to ensure compatibility with the Keras training pipeline. The text inputs were explicitly converted to string arrays and the labels to integer arrays, preventing datatype-related errors during training.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Train BiLSTM Model\n# ==========================================================\n\n\n\nearly_stop = EarlyStopping(\n    monitor=\"val_loss\",\n    patience=2,\n    restore_best_weights=True\n)\n\ncheckpoint = ModelCheckpoint(\n    \"best_bilstm.keras\",\n    monitor=\"val_loss\",\n    save_best_only=True,\n    verbose=1\n)\n\nhistory = model.fit(\n    X_train_tf,\n    y_train_tf,\n    validation_data=(X_val_tf, y_val_tf),\n    epochs=10,\n    batch_size=32,\n    callbacks=[early_stop, checkpoint],\n    verbose=1\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.221838Z","iopub.status.idle":"2026-07-30T16:23:18.222197Z","shell.execute_reply.started":"2026-07-30T16:23:18.222077Z","shell.execute_reply":"2026-07-30T16:23:18.222092Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"The model showed stable convergence with only minor fluctuations in validation performance. No significant overfitting was observed.\nDuring training, the best validation performance was achieved at **Epoch 8**, where the model obtained the lowest validation loss. Although training continued until Epoch 10, the best model weights were automatically preserved using the ModelCheckpoint callback.","metadata":{}},{"cell_type":"markdown","source":"## Model Evaluation\n\nAfter training, the model was evaluated on the validation dataset using the same metrics that were monitored during training.\n\nThe evaluation provides an unbiased estimate of the model's performance on unseen data and verifies that the model has learned meaningful representations without significant overfitting.\n\nThe following metrics are reported:\n\n- **Validation Loss** – Measures the prediction error.\n- **Validation Accuracy** – Measures the proportion of correctly classified samples.\n- **Validation AUC** – Measures the model's ability to distinguish between positive and negative classes across different decision thresholds.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Evaluate BiLSTM Model\n# ==========================================================\n\nval_loss, val_accuracy, val_auc = model.evaluate(\n    X_val_tf,\n    y_val_tf,\n    verbose=1\n)\n\nprint(f\"\\nValidation Loss     : {val_loss:.4f}\")\nprint(f\"Validation Accuracy : {val_accuracy:.4f}\")\nprint(f\"Validation AUC      : {val_auc:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.223333Z","iopub.status.idle":"2026-07-30T16:23:18.223697Z","shell.execute_reply.started":"2026-07-30T16:23:18.223511Z","shell.execute_reply":"2026-07-30T16:23:18.223532Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Validation MAP@3 Evaluation\n\nAlthough the BiLSTM model is trained using Binary Cross-Entropy Loss, the competition evaluates predictions using Mean Average Precision at 3 (MAP@3).\n\nTo estimate competition performance, the model is evaluated on the validation set by:\n\n1. Predicting probabilities for all five answer options.\n2. Ranking the options according to predicted probability.\n3. Comparing the top three predictions with the correct answer.\n4. Computing the Mean Average Precision at 3 (MAP@3).\n\nThis provides a better estimate of competition performance than accuracy alone.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Predict Validation Option Probabilities\n# ==========================================================\n\nval_pairs = []\n\nfor _, row in val_df.iterrows():\n\n    prompt = clean_question(str(row[\"prompt\"]))\n\n    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n        val_pairs.append(\n            prompt + \" [SEP] \" + str(row[option])\n        )\n\nval_pairs = np.array(val_pairs)\n\nval_pairs_tf = tf.constant(val_pairs, dtype=tf.string)\n\nval_scores = model.predict(\n    val_pairs_tf,\n    batch_size=32,\n    verbose=1\n)\n\nval_scores = val_scores.flatten()\n\n# Convert scores into rankings\nval_rankings = []\n\nfor i in range(0, len(val_scores), 5):\n\n    scores = val_scores[i:i+5]\n\n    ranked = np.argsort(scores)[::-1]\n\n    val_rankings.append(ranked)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Convert validation rankings to Top-3 option labels\noptions = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\nbilstm_val_predictions = [\n    [options[idx] for idx in ranking[:3]]\n    for ranking in val_rankings\n]\n\n# Validation MAP@3\nbilstm_map3 = map3_score(\n    val_df[\"answer\"],\n    bilstm_val_predictions\n)\n\nprint(f\"Validation MAP@3: {bilstm_map3:.4f}\")\n\nresults.loc[len(results)] = [\n    \"BiLSTM\",\n    round(bilstm_map3, 4)\n]\n\nresults","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.225362Z","iopub.status.idle":"2026-07-30T16:23:18.225710Z","shell.execute_reply.started":"2026-07-30T16:23:18.225581Z","shell.execute_reply":"2026-07-30T16:23:18.225604Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Prepare Test Data for BiLSTM\n# ==========================================================\n\ntest_pairs = []\n\nfor _, row in test.iterrows():\n    prompt = clean_question(str(row[\"prompt\"]))\n\n    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n        test_pairs.append(\n            prompt + \" [SEP] \" + str(row[option])\n        )\n\ntest_pairs = np.array(test_pairs)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.226823Z","iopub.status.idle":"2026-07-30T16:23:18.227142Z","shell.execute_reply.started":"2026-07-30T16:23:18.227020Z","shell.execute_reply":"2026-07-30T16:23:18.227042Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Predict Option Probabilities\n# ==========================================================\n\ntest_pairs_tf = tf.constant(test_pairs, dtype=tf.string)\n\nbilstm_scores = model.predict(\n    test_pairs_tf,\n    batch_size=32,\n    verbose=1\n)\n\nbilstm_scores = bilstm_scores.flatten()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.227961Z","iopub.status.idle":"2026-07-30T16:23:18.228185Z","shell.execute_reply.started":"2026-07-30T16:23:18.228078Z","shell.execute_reply":"2026-07-30T16:23:18.228091Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Generating Final Submission\n\nThe BiLSTM model predicts a probability for each question-option pair independently.\n\nFor every question:\n\n1. Five probabilities are obtained, one for each option (A–E).\n2. The probabilities are sorted in descending order.\n3. The corresponding option labels are arranged from the highest to the lowest probability.\n4. The ordered option labels form the final prediction required by the competition.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Convert Scores to Ranked Predictions\n# ==========================================================\n\noptions = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\nbilstm_predictions = []\n\nfor i in range(0, len(bilstm_scores), 5):\n\n    scores = bilstm_scores[i:i+5]\n\n    ranked = np.argsort(scores)[::-1]\n\n    prediction = [options[idx] for idx in ranked]\n\n    bilstm_predictions.append(prediction)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.229657Z","iopub.status.idle":"2026-07-30T16:23:18.229928Z","shell.execute_reply.started":"2026-07-30T16:23:18.229783Z","shell.execute_reply":"2026-07-30T16:23:18.229796Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Creating the Submission File\n\nThe ranked predictions generated by the BiLSTM model are combined with the corresponding question IDs to create the final submission file.\n\nThe submission follows the competition format, where each prediction contains the five answer options ordered from the highest to the lowest predicted probability.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Create BiLSTM Submission\n# ==========================================================\n\nsubmission_bilstm = pd.DataFrame({\n    \"ID\": test[\"id\"],\n    \"Prediction\": [\n        \" \".join(pred[:3])\n        for pred in bilstm_predictions\n    ]\n})\n\nsubmission_bilstm.to_csv(\n    \"submission_bilstm.csv\",\n    index=False\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.231407Z","iopub.status.idle":"2026-07-30T16:23:18.231679Z","shell.execute_reply.started":"2026-07-30T16:23:18.231522Z","shell.execute_reply":"2026-07-30T16:23:18.231533Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Transformer (DistilBERT Sequence Classifier)","metadata":{}},{"cell_type":"code","source":"# Model name\nMODEL_NAME = \"distilbert-base-uncased\"\n\n# Load tokenizer\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n\n# Load model\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    MODEL_NAME,\n    num_labels=2\n)\n\n# Check device\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel.to(device)\n\nprint(\"Device:\", device)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.232651Z","iopub.status.idle":"2026-07-30T16:23:18.232991Z","shell.execute_reply.started":"2026-07-30T16:23:18.232830Z","shell.execute_reply":"2026-07-30T16:23:18.232853Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Create binary classification samples\n\ndef build_transformer_dataset(df):\n\n    texts = []\n    labels = []\n\n    for _, row in df.iterrows():\n\n        question = row[\"prompt\"]\n\n        for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n\n            texts.append(\n                question + \" [SEP] \" + str(row[option])\n            )\n\n            labels.append(\n                1 if option == row[\"answer\"] else 0\n            )\n\n    return texts, labels\n\n\ntrain_texts, train_labels = build_transformer_dataset(train_df)\nval_texts, val_labels = build_transformer_dataset(val_df)\n\nprint(\"Training samples :\", len(train_texts))\nprint(\"Validation samples:\", len(val_texts))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.234006Z","iopub.status.idle":"2026-07-30T16:23:18.234225Z","shell.execute_reply.started":"2026-07-30T16:23:18.234117Z","shell.execute_reply":"2026-07-30T16:23:18.234129Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def tokenize_function(examples):\n    return tokenizer(\n        examples[\"text\"],\n        truncation=True,\n        padding=\"max_length\",\n        max_length=128\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.235213Z","iopub.status.idle":"2026-07-30T16:23:18.235571Z","shell.execute_reply.started":"2026-07-30T16:23:18.235380Z","shell.execute_reply":"2026-07-30T16:23:18.235399Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_dataset = Dataset.from_dict({\n    \"text\": train_texts,\n    \"label\": train_labels\n})\n\nval_dataset = Dataset.from_dict({\n    \"text\": val_texts,\n    \"label\": val_labels\n})\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.236731Z","iopub.status.idle":"2026-07-30T16:23:18.237089Z","shell.execute_reply.started":"2026-07-30T16:23:18.236907Z","shell.execute_reply":"2026-07-30T16:23:18.236926Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"data_collator = DataCollatorWithPadding(tokenizer=tokenizer)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.238433Z","iopub.status.idle":"2026-07-30T16:23:18.238803Z","shell.execute_reply.started":"2026-07-30T16:23:18.238629Z","shell.execute_reply":"2026-07-30T16:23:18.238649Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_dataset = train_dataset.map(\n    tokenize_function,\n    batched=True\n)\n\nval_dataset = val_dataset.map(\n    tokenize_function,\n    batched=True\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.240616Z","iopub.status.idle":"2026-07-30T16:23:18.240859Z","shell.execute_reply.started":"2026-07-30T16:23:18.240751Z","shell.execute_reply":"2026-07-30T16:23:18.240764Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def compute_metrics(eval_pred):\n    logits, labels = eval_pred\n\n    predictions = np.argmax(logits, axis=-1)\n\n    precision, recall, f1, _ = precision_recall_fscore_support(\n        labels,\n        predictions,\n        average=\"binary\",\n        zero_division=0\n    )\n\n    accuracy = accuracy_score(labels, predictions)\n\n    return {\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1\": f1,\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.242123Z","iopub.status.idle":"2026-07-30T16:23:18.242477Z","shell.execute_reply.started":"2026-07-30T16:23:18.242286Z","shell.execute_reply":"2026-07-30T16:23:18.242300Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"training_args = TrainingArguments(\n    output_dir=\"./distilbert_results\",\n\n    eval_strategy=\"epoch\",\n    save_strategy=\"epoch\",\n\n    learning_rate=2e-5,\n\n    per_device_train_batch_size=16,\n    per_device_eval_batch_size=16,\n\n    num_train_epochs=3,\n\n    weight_decay=0.01,\n\n    load_best_model_at_end=True,\n\n    logging_steps=100,\n\n    report_to=\"none\"\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.243905Z","iopub.status.idle":"2026-07-30T16:23:18.244353Z","shell.execute_reply.started":"2026-07-30T16:23:18.244227Z","shell.execute_reply":"2026-07-30T16:23:18.244243Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Class weights computed from the binary training labels\nclass_weights = torch.tensor([0.625, 2.5], dtype=torch.float)\n\nclass WeightedTrainer(Trainer):\n\n    def compute_loss(\n        self,\n        model,\n        inputs,\n        return_outputs=False,\n        **kwargs\n    ):\n        labels = inputs.pop(\"labels\")\n\n        outputs = model(**inputs)\n\n        logits = outputs.logits\n\n        loss_fn = nn.CrossEntropyLoss(\n            weight=class_weights.to(logits.device)\n        )\n\n        loss = loss_fn(logits, labels)\n\n        return (loss, outputs) if return_outputs else loss","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.246344Z","iopub.status.idle":"2026-07-30T16:23:18.246732Z","shell.execute_reply.started":"2026-07-30T16:23:18.246506Z","shell.execute_reply":"2026-07-30T16:23:18.246527Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"trainer = WeightedTrainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset,\n    eval_dataset=val_dataset,\n    data_collator=data_collator,\n    compute_metrics=compute_metrics,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.247697Z","iopub.status.idle":"2026-07-30T16:23:18.248046Z","shell.execute_reply.started":"2026-07-30T16:23:18.247878Z","shell.execute_reply":"2026-07-30T16:23:18.247895Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_result = trainer.train()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.249482Z","iopub.status.idle":"2026-07-30T16:23:18.249848Z","shell.execute_reply.started":"2026-07-30T16:23:18.249673Z","shell.execute_reply":"2026-07-30T16:23:18.249693Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"metrics = trainer.evaluate()\n\nprint(metrics)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.251453Z","iopub.status.idle":"2026-07-30T16:23:18.251823Z","shell.execute_reply.started":"2026-07-30T16:23:18.251656Z","shell.execute_reply":"2026-07-30T16:23:18.251676Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def predict_transformer_top3(df, model, tokenizer):\n\n    if hasattr(model, \"model\"):\n        model = model.model\n        \n    model.eval()\n\n    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    predictions = []\n\n    for _, row in df.iterrows():\n\n        scores = []\n\n        for option in options:\n\n            text = row[\"prompt\"] + \" [SEP] \" + str(row[option])\n\n            inputs = tokenizer(\n                text,\n                return_tensors=\"pt\",\n                truncation=True,\n                padding=\"max_length\",\n                max_length=128\n            )\n\n            inputs = {k: v.to(device) for k, v in inputs.items()}\n\n            with torch.no_grad():\n                outputs = model(**inputs)\n\n                logits = outputs.logits\n\n                probability = torch.softmax(logits, dim=1)[0, 1].item()\n\n            scores.append(probability)\n\n        ranked = np.argsort(scores)[::-1]\n\n        predictions.append([options[i] for i in ranked[:3]])\n\n    return predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.253056Z","iopub.status.idle":"2026-07-30T16:23:18.253420Z","shell.execute_reply.started":"2026-07-30T16:23:18.253240Z","shell.execute_reply":"2026-07-30T16:23:18.253260Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Validation MAP@3\n# ==========================================================\n\ntransformer_val_predictions = predict_transformer_top3(\n    val_df,\n    trainer,\n    tokenizer\n)\n\ntransformer_map3 = map3_score(\n    val_df[\"answer\"],\n    transformer_val_predictions\n)\n\nprint(f\"Transformer Validation MAP@3: {transformer_map3:.4f}\")\n\nresults.loc[len(results)] = [\n    \"DistilBERT\",\n    round(transformer_map3, 4)\n]\n\nresults","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T16:23:18.254592Z","iopub.status.idle":"2026-07-30T16:23:18.254909Z","shell.execute_reply.started":"2026-07-30T16:23:18.254760Z","shell.execute_reply":"2026-07-30T16:23:18.254777Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"transformer_test_predictions = predict_transformer_top3(\n    test,\n    model,\n    tokenizer\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"20