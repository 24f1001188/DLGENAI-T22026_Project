cation/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"55f28d2ad1aa4143ac2e6007c7f3b671"}},"metadata":{}},{"name":"stderr","text":"BertModel LOAD REPORT from: sentence-transformers/all-MiniLM-L6-v2\nKey                     | Status     |  | \n------------------------+------------+--+-\nembeddings.position_ids | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"}],"execution_count":210},{"cell_type":"code","source":"def predict_sentence_transformer_top3(df, model):\n    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    predictions = []\n\n    for _, row in df.iterrows():\n        texts = [\n            row[\"prompt\"],\n            row[\"A\"],\n            row[\"B\"],\n            row[\"C\"],\n            row[\"D\"],\n            row[\"E\"]\n        ]\n\n        embeddings = model.encode(\n            texts,\n            convert_to_numpy=True,\n            normalize_embeddings=True\n        )\n\n        prompt_embedding = embeddings[0]\n        option_embeddings = embeddings[1:]\n        \n        similarities = np.dot(option_embeddings, prompt_embedding)\n        \n        ranked_indices = np.argsort(similarities)[::-1]\n\n        top3 = [options[i] for i in ranked_indices[:3]]\n        predictions.append(top3)\n\n    return predictions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-05T12:28:31.716354Z","iopub.execute_input":"2026-08-05T12:28:31.716706Z","iopub.status.idle":"2026-08-05T12:28:31.723071Z","shell.execute_reply.started":"2026-08-05T12:28:31.716683Z","shell.execute_reply":"2026-08-05T12:28:31.722045Z"}},"outputs":[],"execution_count":211},{"cell_type":"code","source":"sentence_transformer_val_predictions = predict_sentence_transformer_top3(val_df, embedding_model)\nsentence_transformer_map3 = map3_score(val_df[\"answer\"], sentence_transformer_val_predictions)\n\nprint(\"Sentence Transformer Embedding MAP@3:\", round(sentence_transformer_map3, 4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-05T12:28:31.724155Z","iopub.execute_input":"2026-08-05T12:28:31.724404Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"results.loc[len(results)] = [\n    \"Sentence Transformer\",\n    round(sentence_transformer_map3, 4)\n]\n\n\nresults","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"sentence_transformer_test_predictions = predict_sentence_transformer_top3(\n    test,\n    embedding_model\n)\n\nsubmission_sentence_transformer = pd.DataFrame({\n    \"ID\": test[\"id\"],\n    \"Prediction\": [\n        \" \".join(pred)\n        for pred in sentence_transformer_test_predictions\n    ]\n})\n\nsubmission_sentence_transformer.to_csv(\"submission_sentence_transformer.csv\", index=False)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Zero-Shot Classification Baseline\n\nIn this section, we use the pre-trained `facebook/bart-large-mnli` model to perform zero-shot classification. Unlike similarity-based retrieval methods, this model directly estimates the probability of each answer option being correct without any task-specific training.\n\nThe five answer choices (A-E) are provided as candidate labels, and the top three predictions are evaluated using the MAP@3 metric.","metadata":{}},{"cell_type":"code","source":"zs = pipeline(\n    \"zero-shot-classification\",\n    model=\"facebook/bart-large-mnli\",\n    device=0 if device == \"cuda\" else -1\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def predict_zero_shot_top3(df, classifier):\n\n    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    predictions = []\n\n    for _, row in df.iterrows():\n\n        prompt = str(row[\"prompt\"])\n\n        labels = [\n            str(row[\"A\"]),\n            str(row[\"B\"]),\n            str(row[\"C\"]),\n            str(row[\"D\"]),\n            str(row[\"E\"])\n        ]\n\n        result = classifier(\n            prompt,\n            candidate_labels=labels\n        )\n\n        predicted_letters = []\n\n        for predicted_label in result[\"labels\"][:3]:\n            for option in options:\n                if predicted_label == str(row[option]):\n                    predicted_letters.append(option)\n                    break\n\n        predictions.append(predicted_letters)\n\n    return predictions","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"zero_shot_val_predictions = predict_zero_shot_top3(\n    val_df,\n    zs\n)\n\nzero_shot_map3 = map3_score(\n    val_df[\"answer\"],\n    zero_shot_val_predictions\n)\n\nprint(\"Zero-Shot Classification MAP@3:\", round(zero_shot_map3, 4))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"results.loc[len(results)] = [\n    \"Zero-Shot Classification (BART-MNLI)\",\n    round(zero_shot_map3, 4)\n]\n\n\nresults","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"zero_shot_test_predictions = predict_zero_shot_top3(\n    test,\n    zs\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"submission_zero_shot = pd.DataFrame({\n    \"ID\": test[\"id\"],\n    \"Prediction\": [\n        \" \".join(pred)\n        for pred in zero_shot_test_predictions\n    ]\n})\n\nsubmission_zero_shot.to_csv(\"submission_zero_shot.csv\", index=False)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Retrieval-Augmented Generation (RAG)\n\nWe enhance the MCQ solver by incorporating Retrieval-Augmented Generation (RAG). Instead of relying solely on the model's internal knowledge, we first retrieve relevant information from a knowledge base using dense vector search (FAISS). The retrieved documents are then reranked using a Cross-Encoder to improve retrieval quality before being used to augment the question. This approach enables the model to answer questions using both retrieved context and transformer-based reasoning.","metadata":{}},{"cell_type":"markdown","source":"## Knowledge Base Creation\n\nIn Retrieval-Augmented Generation (RAG), the first step is to construct a knowledge base containing the correct answers from the training dataset. Each correct answer serves as a document that can later be retrieved using semantic similarity search.","metadata":{}},{"cell_type":"code","source":"kb = []\n\nfor _, row in train_df.iterrows():\n    correct_letter = row[\"answer\"]\n    kb.append(str(row[correct_letter]))\n\nprint(f\"Knowledge base created with {len(kb)} documents.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Building the FAISS Index\n\nThe knowledge base documents are converted into dense vector embeddings using the Sentence Transformer model. These embeddings are then indexed using FAISS, enabling efficient similarity search during retrieval.","metadata":{}},{"cell_type":"code","source":"kb_embeddings = embedding_model.encode(\n    kb,\n    convert_to_numpy=True,\n    show_progress_bar=True\n)\n\n\nindex = faiss.IndexFlatL2(kb_embeddings.shape[1])\nindex.add(kb_embeddings)\n\nprint(f\"Indexed {index.ntotal} documents.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Dense Retrieval using FAISS\n\nGiven a question, we first generate its embedding using the Sentence Transformer model. The embedding is then used to query the FAISS index, retrieving the top-k most semantically similar documents from the knowledge base. These retrieved documents serve as candidate contexts for the subsequent reranking stage.","metadata":{}},{"cell_type":"code","source":"def retrieve_documents(prompt, k=5):\n    \"\"\"\n    Retrieve the top-k most similar documents from the knowledge base.\n    \"\"\"\n\n    prompt_embedding = embedding_model.encode(\n        [prompt],\n        convert_to_numpy=True\n    )\n\n    distances, indices = index.search(prompt_embedding, k)\n\n    retrieved_docs = [kb[i] for i in indices[0]]\n\n    return retrieved_docs, indices[0], distances[0]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Cross-Encoder Reranking\n\nThe initial retrieval step uses a bi-encoder, which retrieves documents efficiently based on embedding similarity. However, embedding similarity alone may not capture the exact semantic relationship between the question and the retrieved document.\n\nTo improve retrieval quality, we use a Cross-Encoder. Unlike a bi-encoder, the Cross-Encoder processes the question and each retrieved document together, allowing the attention mechanism to directly model interactions between them. The retrieved documents are then reranked based on their semantic relevance scores.","metadata":{}},{"cell_type":"code","source":"cross_encoder = CrossEncoder(\n    \"cross-encoder/ms-marco-MiniLM-L-6-v2\"\n)\n\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def rerank_documents(prompt, retrieved_docs):\n    \"\"\"\n    Rerank retrieved documents using a Cross-Encoder.\n    \"\"\"\n\n    pairs = [[prompt, doc] for doc in retrieved_docs]\n\n    scores = cross_encoder.predict(pairs)\n\n    ranked_indices = np.argsort(scores)[::-1]\n\n    reranked_docs = [retrieved_docs[i] for i in ranked_indices]\n\n    return reranked_docs, scores[ranked_indices]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"The complete RAG pipeline combines dense retrieval, cross-encoder reranking, and transformer-based zero-shot classification. For each question, the top-k documents are first retrieved from the knowledge base using FAISS. These documents are then reranked using a Cross-Encoder, and the highest-ranked document is appended as additional context before performing zero-shot classification. This enables the model to answer questions using both retrieved knowledge and its internal reasoning capabilities.","metadata":{}},{"cell_type":"code","source":"def predict_rag_top3(df, embedding_model):\n    \"\"\"\n    Predict top-3 answer choices using the complete RAG pipeline.\n    \"\"\"\n\n    predictions = []\n\n    for _, row in df.iterrows():\n\n        prompt = row[\"prompt\"]\n\n        # Retrieve documents\n        retrieved_docs, _, _ = retrieve_documents(prompt, k=5)\n\n        # Rerank documents\n        reranked_docs, _ = rerank_documents(prompt, retrieved_docs)\n\n        # Best document\n        best_document = reranked_docs[0]\n\n        # Create RAG prompt\n        rag_prompt = f\"Context: {best_document} Question: {prompt}\"\n\n        candidate_labels = [\n            row[\"A\"],\n            row[\"B\"],\n            row[\"C\"],\n            row[\"D\"],\n            row[\"E\"]\n        ]\n\n        result = zs(\n            rag_prompt,\n            candidate_labels,\n            multi_label=False\n        )\n\n        option_map = {\n            row[option]: option\n            for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]\n        }\n\n        top3 = [\n            option_map[label]\n            for label in result[\"labels\"][:3]\n        ]\n\n        predictions.append(top3)\n\n    return predictions","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"rag_val_predictions = predict_rag_top3(\n    val_df,\n    embedding_model\n)\n\nrag_map3 = map3_score(\n    val_df[\"answer\"],\n    rag_val_predictions\n)\n\nprint(f\"RAG MAP@3: {rag_map3:.4f}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"results.loc[len(results)] = [\n    \"RAG Pipeline\",\n    round(rag_map3, 4)\n]\n\n\nresults","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"rag_test_predictions = predict_rag_top3(\n    test,\n    embedding_model\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"submission_rag = pd.DataFrame({\n    \"ID\": test[\"id\"],\n    \"Prediction\": [\n        \" \".join(pred)\n        for pred in rag_test_predictions\n    ]\n})\n\nsubmission_rag.to_csv(\n    \"submission_rag.csv\",\n    index=False\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# BiLSTM (Built from Scratch)\n\nThis section implements a deep learning model built from scratch using TensorFlow/Keras.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Remove Repeated Instruction Phrases\n# ==========================================================\n\ndef clean_question(question):\n    question = question.lower()\n\n    question = question.replace(\"pick the best possible answer\", \"\")\n    question = question.replace(\"among the listed options\", \"\")\n\n    return \" \".join(question.split())\n\n\n\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n# ==========================================================\n# Build BiLSTM Dataset\n# ==========================================================\n\ndef build_bilstm_dataset(df):\n    bilstm_data = []\n\n    for _, row in df.iterrows():\n\n        question = clean_question(str(row[\"prompt\"]))\n\n        for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n\n            bilstm_data.append({\n                \"text\": question + \" [SEP] \" + str(row[option]),\n                \"label\": 1 if option == row[\"answer\"] else 0\n            })\n\n    return pd.DataFrame(bilstm_data)\n\nbilstm_train_df = build_bilstm_dataset(train_df)\nbilstm_val_df = build_bilstm_dataset(val_df)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"X_train = bilstm_train_df[\"text\"]\ny_train = bilstm_train_df[\"label\"]\n\nX_val = bilstm_val_df[\"text\"]\ny_val = bilstm_val_df[\"label\"]","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Hyperparameter Analysis for BiLSTM","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Hyperparameter Analysis\n# ==========================================================\n\n# Number of words in each sample\nword_counts = bilstm_train_df[\"text\"].apply(lambda x: len(str(x).split()))\n\nprint(\"=\"*50)\nprint(\"TEXT LENGTH ANALYSIS\")\nprint(\"=\"*50)\n\nprint(f\"Number of samples        : {len(word_counts)}\")\nprint(f\"Average length           : {word_counts.mean():.2f} words\")\nprint(f\"Median length            : {word_counts.median():.0f} words\")\nprint(f\"Maximum length           : {word_counts.max()} words\")\nprint(f\"95th Percentile Length   : {np.percentile(word_counts,95):.0f} words\")\nprint(f\"99th Percentile Length   : {np.percentile(word_counts,99):.0f} words\")\n\nprint(\"\\n\" + \"=\"*50)\nprint(\"VOCABULARY ANALYSIS\")\nprint(\"=\"*50)\n\nall_words = \" \".join(bilstm_train_df[\"text\"]).lower().split()\n\nvocab_counter = Counter(all_words)\n\nprint(f\"Total words              : {len(all_words):,}\")\nprint(f\"Unique words             : {len(vocab_counter):,}\")\n\nprint(\"\\nTop 20 most common words:\\n\")\n\nfor word, freq in vocab_counter.most_common(20):\n    print(f\"{word:20s} {freq}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Hyperparameter selection was based on dataset statistics rather than arbitrary values. The sequence length analysis showed that 95% of the samples contained 82 words or fewer and 99% contained 103 words or fewer. Therefore, a maximum sequence length of 128 was selected to preserve nearly all samples while maintaining computational efficiency. Vocabulary analysis revealed approximately 3,100 unique words in the dataset. Consequently, the vocabulary size was limited to 3,500, which covers the complete vocabulary while reducing unnecessary model parameters and memory usage.","metadata":{}},{"cell_type":"markdown","source":"For the BiLSTM model, natural sentence structure was preserved by retaining stopwords, as recurrent neural networks benefit from contextual information. Only fixed instructional phrases that appeared identically in every sample (e.g., \"pick the best possible answer\" and \"among the listed options\") were removed because they do not contribute to distinguishing the correct answer and introduce unnecessary noise.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Text Vectorization\n# ==========================================================\n\n\nVOCAB_SIZE = 3500\nMAX_LENGTH = 128\n\nvectorizer = TextVectorization(\n    max_tokens=VOCAB_SIZE,\n    output_mode=\"int\",\n    output_sequence_length=MAX_LENGTH\n)\n\n# Learn the vocabulary from the training data\nvectorizer.adapt(X_train)\n\nprint(\"=\"*50)\nprint(\"TEXT VECTORIZATION\")\nprint(\"=\"*50)\nprint(f\"Vocabulary learned : {len(vectorizer.get_vocabulary())}\")\nprint(f\"Maximum sequence length : {MAX_LENGTH}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"The embedding dimension determines the size of the dense vector representing each word. Since the dataset contains only around 3,100 unique words and 10,000 training samples, a 64-dimensional embedding provides sufficient capacity to learn semantic relationships while keeping the number of trainable parameters low. Larger embeddings such as 128 or 300 would increase computational cost and the risk of overfitting without a clear benefit for this dataset.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Build BiLSTM Model\n# ==========================================================\n\n\n\nEMBEDDING_DIM = 64\n\nmodel = Sequential([\n    \n    # Convert text to integer tokens\n    vectorizer,\n\n    # Learn word embeddings\n    Embedding(\n    input_dim=len(vectorizer.get_vocabulary()),\n    output_dim=EMBEDDING_DIM,\n    mask_zero=True\n),\n\n    # Bidirectional LSTM\n    Bidirectional(\n        LSTM(64, return_sequences=True)\n    ),\n\n    # Keep the strongest features\n    GlobalMaxPooling1D(),\n\n    # Reduce overfitting\n    Dropout(0.30),\n\n    # Dense hidden layer\n    Dense(32, activation=\"relu\"),\n\n    # Binary classification\n    Dense(1, activation=\"sigmoid\")\n])\n\ndummy_input = tf.constant([\"This is a sample sentence.\"])\n_ = model(dummy_input)\nmodel.summary()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Compile BiLSTM Model\n# ==========================================================\n\n\n\nmodel.compile(\n    optimizer=Adam(learning_rate=0.001),\n    loss=\"binary_crossentropy\",\n    metrics=[\n        \"accuracy\",\n        tf.keras.metrics.Precision(name=\"precision\"),\n        tf.keras.metrics.Recall(name=\"recall\"),\n        tf.keras.metrics.AUC(name=\"auc\")\n    ]\n)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Model Compilation\n\nThe BiLSTM model was compiled using the **Adam optimizer**, **Binary Cross-Entropy loss function**, and **Accuracy** as the evaluation metric. These choices were made based on the nature of the dataset and the binary classification problem.\n\n### 1. Optimizer: Adam\n\nThe Adam (Adaptive Moment Estimation) optimizer was selected because it combines the advantages of Momentum and RMSProp. It automatically adapts the learning rate for each parameter, resulting in faster convergence and more stable training. Adam is widely used in Natural Language Processing tasks due to its efficiency and robustness.\n\n### 2. Learning Rate: 0.001\n\nA learning rate of **0.001** was chosen because it is the default and most commonly recommended value for the Adam optimizer. It provides a good balance between learning speed and training stability. Higher learning rates may cause unstable training, while lower values increase the training time without significant performance improvements for this dataset.\n\n### 3. Loss Function: Binary Cross-Entropy\n\nThe problem was formulated as a **binary classification** task, where each question-option pair is labelled as:\n\n- **1** → Correct answer\n- **0** → Incorrect answer\n\nSince the output layer consists of a single neuron with a **Sigmoid activation function**, Binary Cross-Entropy is the most appropriate loss function for measuring the prediction error.\n\n### 4. Evaluation Metrics: Accuracy and AUC\n\nTwo evaluation metrics were used during training:\n\n- **Accuracy** measures the percentage of correctly classified question-option pairs and provides an intuitive indication of the model's performance.\n- **AUC (Area Under the ROC Curve)** evaluates the model's ability to distinguish between the positive (correct answer) and negative (incorrect answer) classes across different classification thresholds. Unlike accuracy, AUC is less sensitive to the chosen decision threshold and provides a more comprehensive measure of classification performance.\n\nUsing both metrics allows the model to be evaluated from different perspectives, providing a more reliable assessment of its learning behaviour.\n\n### Summary\n\n| Hyperparameter | Selected Value | Justification |\n|----------------|---------------|---------------|\n| Optimizer | Adam | Fast convergence and adaptive learning rates for NLP tasks |\n| Learning Rate | 0.001 | Stable default value for Adam that balances speed and convergence |\n| Loss Function | Binary Cross-Entropy | Suitable for binary classification using Sigmoid output |\n| Evaluation Metric | Accuracy, AUC| Accuracy measures correct predictions, while AUC evaluates the model's discrimination ability across thresholds |","metadata":{}},{"cell_type":"markdown","source":"## Model Training\n\nThe model was trained using **EarlyStopping** and **ModelCheckpoint** callbacks to improve generalization and avoid unnecessary training.\n\n### 1. EarlyStopping\n\nThe EarlyStopping callback monitors the validation loss during training. If the validation loss does not improve for several consecutive epochs, the training process is stopped automatically. This helps prevent overfitting and reduces unnecessary computation.\n\nThe best model weights are restored automatically after training.\n\n### 2. ModelCheckpoint\n\nThe ModelCheckpoint callback saves the model whenever the validation loss improves. This ensures that the best-performing model is preserved, even if subsequent epochs lead to overfitting.\n\n### Training Configuration\n\n- Optimizer: Adam\n- Loss Function: Binary Cross-Entropy\n- Metrics: Accuracy and AUC\n- Batch Size: 32\n- Maximum Epochs: 10\n- EarlyStopping Patience: 2 epochs","metadata":{}},{"cell_type":"code","source":"# Convert text to NumPy string arrays\nX_train_tf = X_train.astype(str).to_numpy()\nX_val_tf = X_val.astype(str).to_numpy()\n\n# Convert labels to NumPy integer arrays\ny_train_tf = y_train.to_numpy(dtype=np.int32)\ny_val_tf = y_val.to_numpy(dtype=np.int32)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"TensorFlow models were trained using NumPy arrays rather than Pandas Series to ensure compatibility with the Keras training pipeline. The text inputs were explicitly converted to string arrays and the labels to integer arrays, preventing datatype-related errors during training.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Train BiLSTM Model\n# ==========================================================\n\n\n\nearly_stop = EarlyStopping(\n    monitor=\"val_loss\",\n    patience=2,\n    restore_best_weights=True\n)\n\ncheckpoint = ModelCheckpoint(\n    \"best_bilstm.keras\",\n    monitor=\"val_loss\",\n    save_best_only=True,\n    verbose=1\n)\n\nhistory = model.fit(\n    X_train_tf,\n    y_train_tf,\n    validation_data=(X_val_tf, y_val_tf),\n    epochs=10,\n    batch_size=32,\n    callbacks=[early_stop, checkpoint],\n    verbose=1\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"The model showed stable convergence with only minor fluctuations in validation performance. No significant overfitting was observed.\nDuring training, the best validation performance was achieved at **Epoch 8**, where the model obtained the lowest validation loss. Although training continued until Epoch 10, the best model weights were automatically preserved using the ModelCheckpoint callback.","metadata":{}},{"cell_type":"markdown","source":"## Model Evaluation\n\nAfter training, the model was evaluated on the validation dataset using the same metrics that were monitored during training.\n\nThe evaluation provides an unbiased estimate of the model's performance on unseen data and verifies that the model has learned meaningful representations without significant overfitting.\n\nThe following metrics are reported:\n\n- **Validation Loss** – Measures the prediction error.\n- **Validation Accuracy** – Measures the proportion of correctly classified samples.\n- **Validation AUC** – Measures the model's ability to distinguish between positive and negative classes across different decision thresholds.","metadata":{}},{"cell_type":"code","source":"# Evaluate BiLSTM on validation data\nval_results = model.evaluate(\n    X_val_tf,\n    y_val_tf,\n    batch_size=32,\n    verbose=0,\n    return_dict=True\n)\n\nval_loss = val_results[\"loss\"]\nval_accuracy = val_results[\"accuracy\"]\nval_precision = val_results[\"precision\"]\nval_recall = val_results[\"recall\"]\nval_auc = val_results[\"auc\"]\n\n# F1 score from Precision and Recall\nval_f1 = (\n    2 * val_precision * val_recall / (val_precision + val_recall)\n    if (val_precision + val_recall) > 0\n    else 0.0\n)\n\nprint(f\"Validation Loss      : {val_loss:.4f}\")\nprint(f\"Validation Accuracy  : {val_accuracy:.4f}\")\nprint(f\"Validation Precision : {val_precision:.4f}\")\nprint(f\"Validation Recall    : {val_recall:.4f}\")\nprint(f\"Validation F1        : {val_f1:.4f}\")\nprint(f\"Validation AUC       : {val_auc:.4f}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Validation MAP@3 Evaluation\n\nAlthough the BiLSTM model is trained using Binary Cross-Entropy Loss, the competition evaluates predictions using Mean Average Precision at 3 (MAP@3).\n\nTo estimate competition performance, the model is evaluated on the validation set by:\n\n1. Predicting probabilities for all five answer options.\n2. Ranking the options according to predicted probability.\n3. Comparing the top three predictions with the correct answer.\n4. Computing the Mean Average Precision at 3 (MAP@3).\n\nThis provides a better estimate of competition performance than accuracy alone.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Predict Validation Option Probabilities\n# ==========================================================\n\nval_pairs = []\n\nfor _, row in val_df.iterrows():\n\n    prompt = clean_question(str(row[\"prompt\"]))\n\n    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n        val_pairs.append(\n            prompt + \" [SEP] \" + str(row[option])\n        )\n\nval_pairs = np.array(val_pairs)\n\nval_pairs_tf = tf.constant(val_pairs, dtype=tf.string)\n\nval_scores = model.predict(\n    val_pairs_tf,\n    batch_size=32,\n    verbose=1\n)\n\nval_scores = val_scores.flatten()\n\n# Convert scores into rankings\nval_rankings = []\n\nfor i in range(0, len(val_scores), 5):\n\n    scores = val_scores[i:i+5]\n\n    ranked = np.argsort(scores)[::-1]\n\n    val_rankings.append(ranked)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Convert validation rankings to Top-3 option labels\noptions = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\nbilstm_val_predictions = [\n    [options[idx] for idx in ranking[:3]]\n    for ranking in val_rankings\n]\n\n# Validation MAP@3\nbilstm_map3 = map3_score(\n    val_df[\"answer\"],\n    bilstm_val_predictions\n)\n\nprint(f\"Validation MAP@3: {bilstm_map3:.4f}\")\n\nresults.loc[len(results)] = [\n    \"BiLSTM\",\n    round(bilstm_map3, 4)\n]\n\nresults","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Prepare Test Data for BiLSTM\n# ==========================================================\n\ntest_pairs = []\n\nfor _, row in test.iterrows():\n    prompt = clean_question(str(row[\"prompt\"]))\n\n    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n        test_pairs.append(\n            prompt + \" [SEP] \" + str(row[option])\n        )\n\ntest_pairs = np.array(test_pairs)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Predict Option Probabilities\n# ==========================================================\n\ntest_pairs_tf = tf.constant(test_pairs, dtype=tf.string)\n\nbilstm_scores = model.predict(\n    test_pairs_tf,\n    batch_size=32,\n    verbose=1\n)\n\nbilstm_scores = bilstm_scores.flatten()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Generating Final Submission\n\nThe BiLSTM model predicts a probability for each question-option pair independently.\n\nFor every question:\n\n1. Five probabilities are obtained, one for each option (A–E).\n2. The probabilities are sorted in descending order.\n3. The corresponding option labels are arranged from the highest to the lowest probability.\n4. The ordered option labels form the final prediction required by the competition.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Convert Scores to Ranked Predictions\n# ==========================================================\n\noptions = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n\nbilstm_predictions = []\n\nfor i in range(0, len(bilstm_scores), 5):\n\n    scores = bilstm_scores[i:i+5]\n\n    ranked = np.argsort(scores)[::-1]\n\n    prediction = [options[idx] for idx in ranked]\n\n    bilstm_predictions.append(prediction)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Creating the Submission File\n\nThe ranked predictions generated by the BiLSTM model are combined with the corresponding question IDs to create the final submission file.\n\nThe submission follows the competition format, where each prediction contains the five answer options ordered from the highest to the lowest predicted probability.","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# Create BiLSTM Submission\n# ==========================================================\n\nsubmission_bilstm = pd.DataFrame({\n    \"ID\": test[\"id\"],\n    \"Prediction\": [\n        \" \".join(pred[:3])\n        for pred in bilstm_predictions\n    ]\n})\n\nsubmission_bilstm.to_csv(\n    \"submission_bilstm.csv\",\n    index=False\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Transformer (DistilBERT Sequence Classifier)","metadata":{}},{"cell_type":"code","source":"# Model name\nMODEL_NAME = \"distilbert-base-uncased\"\n\n# Load tokenizer\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n\n# Load model\nmodel = AutoModelForSequenceClassification.from_pretrained(\n    MODEL_NAME,\n    num_labels=2\n)\n\n# Check device\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel.to(device)\n\nprint(\"Device:\", device)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Create binary classification samples\n\ndef build_transformer_dataset(df):\n\n    texts = []\n    labels = []\n\n    for _, row in df.iterrows():\n\n        question = row[\"prompt\"]\n\n        for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n\n            texts.append(\n                question + \" [SEP] \" + str(row[option])\n            )\n\n            labels.append(\n                1 if option == row[\"answer\"] else 0\n            )\n\n    return texts, labels\n\n\ntrain_texts, train_labels = build_transformer_dataset(train_df)\nval_texts, val_labels = build_transformer_dataset(val_df)\n\nprint(\"Training samples :\", len(train_texts))\nprint(\"Validation samples:\", len(val_texts))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def tokenize_function(examples):\n    return tokenizer(\n        examples[\"text\"],\n        truncation=True,\n        padding=\"max_length\",\n        max_length=128\n    )","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_dataset = Dataset.from_dict({\n    \"text\": train_texts,\n    \"label\": train_labels\n})\n\nval_dataset = Dataset.from_dict({\n    \"text\": val_texts,\n    \"label\": val_labels\n})\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"data_collator = DataCollatorWithPadding(tokenizer=tokenizer)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_dataset = train_dataset.map(\n    tokenize_function,\n    batched=True\n)\n\nval_dataset = val_dataset.map(\n    tokenize_function,\n    batched=True\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def compute_metrics(eval_pred):\n    logits, labels = eval_pred\n\n    predictions = np.argmax(logits, axis=-1)\n\n    precision, recall, f1, _ = precision_recall_fscore_support(\n        labels,\n        predictions,\n        average=\"binary\",\n        zero_division=0\n    )\n\n    accuracy = accuracy_score(labels, predictions)\n\n    return {\n        \"accuracy\": accuracy,\n        \"precision\": precision,\n        \"recall\": recall,\n        \"f1\": f1,\n    }","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"training_args = TrainingArguments(\n    output_dir=\"./distilbert_results\",\n\n    eval_strategy=\"epoch\",\n    save_strategy=\"epoch\",\n\n    learning_rate=2e-5,\n\n    per_device_train_batch_size=16,\n    per_device_eval_batch_size=16,\n\n    num_train_epochs=3,\n\n    weight_decay=0.01,\n\n    load_best_model_at_end=True,\n\n    logging_steps=100,\n\n    report_to=\"none\"\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Class weights computed from the binary training labels\nclass_weights = torch.tensor([0.625, 2.5], dtype=torch.float)\n\nclass WeightedTrainer(Trainer):\n\n    def compute_loss(\n        self,\n        model,\n        inputs,\n        return_outputs=False,\n        **kwargs\n    ):\n        labels = inputs.pop(\"labels\")\n\n        outputs = model(**inputs)\n\n        logits = outputs.logits\n\n        loss_fn = nn.CrossEntropyLoss(\n            weight=class_weights.to(logits.device)\n        )\n\n        loss = loss_fn(logits, labels)\n\n        return (loss, outputs) if return_outputs else loss","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"trainer = WeightedTrainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_dataset,\n    eval_dataset=val_dataset,\n    data_collator=data_collator,\n    compute_metrics=compute_metrics,\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_result = trainer.train()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"metrics = trainer.evaluate()\n\nprint(metrics)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def predict_transformer_top3(df, model, tokenizer):\n\n    if hasattr(model, \"model\"):\n        model = model.model\n        \n    model.eval()\n\n    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    predictions = []\n\n    for _, row in df.iterrows():\n\n        scores = []\n\n        for option in options:\n\n            text = row[\"prompt\"] + \" [SEP] \" + str(row[option])\n\n            inputs = tokenizer(\n                text,\n                return_tensors=\"pt\",\n                truncation=True,\n                padding=\"max_length\",\n                max_length=128\n            )\n\n            inputs = {k: v.to(device) for k, v in inputs.items()}\n\n            with torch.no_grad():\n                outputs = model(**inputs)\n\n                logits = outputs.logits\n\n                probability = torch.softmax(logits, dim=1)[0, 1].item()\n\n            scores.append(probability)\n\n        ranked = np.argsort(scores)[::-1]\n\n        predictions.append([options[i] for i in ranked[:3]])\n\n    return predictions","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Validation MAP@3\n# ==========================================================\n\ntransformer_val_predictions = predict_transformer_top3(\n    val_df,\n    trainer,\n    tokenizer\n)\n\ntransformer_map3 = map3_score(\n    val_df[\"answer\"],\n    transformer_val_predictions\n)\n\nprint(f\"Transformer Validation MAP@3: {transformer_map3:.4f}\")\n\nresult