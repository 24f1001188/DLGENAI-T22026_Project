    "def clean_text(text, remove_stopwords=False, tokenize=False):\n",
    "    \"\"\"\n",
    "    Cleans input text by:\n",
    "    1. Converting to lowercase\n",
    "    2. Removing punctuation\n",
    "    3. Optionally removing English stopwords\n",
    "    4. Optionally tokenizing the text\n",
    "    \"\"\"\n",
    "\n",
    "    text = text.lower()\n",
    "    text = text.translate(str.maketrans('', '', string.punctuation))\n",
    "    words = text.split()\n",
    "\n",
    "    if remove_stopwords:\n",
    "        words = [word for word in words if word not in ENGLISH_STOP_WORDS]\n",
    "\n",
    "    if tokenize:\n",
    "        return words\n",
    "\n",
    "    return \" \".join(words)"
   ]
