    "def preprocess(example):\n",
    "    choices = [\n",
    "        str(example[\"prompt\"]) + \" [SEP] \" + str(example[option])\n",
    "        for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    ]\n",
    "\n",
    "    encoding = mc_tokenizer(\n",
    "        choices,\n",
    "        padding=\"max_length\",\n",
    "        truncation=True,\n",
    "        max_length=64,\n",
    "    )\n",
    "\n",
    "    encoding[\"labels\"] = example[\"label\"]\n",
    "\n",
    "    return encoding"
