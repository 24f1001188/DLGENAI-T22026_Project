    "# ==========================================================\n",
    "# Error Analysis\n",
    "# ==========================================================\n",
    "\n",
    "# Extract Top-1 predictions from existing Top-3 predictions\n",
    "bilstm_top1 = [pred[0] for pred in bilstm_val_predictions]\n",
    "distilbert_top1 = [pred[0] for pred in transformer_val_predictions]\n",
    "rag_top1 = [pred[0] for pred in rag_val_predictions]\n",
    "\n",
    "y_true = val_df[\"answer\"].tolist()\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# 1. Error summary\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "error_summary = pd.DataFrame({\n",
    "    \"Model\": [\"BiLSTM\", \"DistilBERT\", \"RAG\"],\n",
    "    \"Total Samples\": [len(y_true)] * 3,\n",
    "    \"Incorrect Predictions\": [\n",
    "        sum(t != p for t, p in zip(y_true, bilstm_top1)),\n",
    "        sum(t != p for t, p in zip(y_true, distilbert_top1)),\n",
    "        sum(t != p for t, p in zip(y_true, rag_top1))\n",
    "    ]\n",
    "})\n",
    "\n",
    "error_summary[\"Error Rate\"] = (\n",
    "    error_summary[\"Incorrect Predictions\"] /\n",
    "    error_summary[\"Total Samples\"]\n",
    ")\n",
    "\n",
    "print(\"Error Summary\")\n",
    "display(error_summary)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# 2. Create detailed prediction table\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "error_analysis = val_df[\n",
    "    [\"prompt\", \"A\", \"B\", \"C\", \"D\", \"E\", \"answer\"]\n",
    "].copy()\n",
    "\n",
    "error_analysis[\"BiLSTM Prediction\"] = bilstm_top1\n",
    "error_analysis[\"DistilBERT Prediction\"] = distilbert_top1\n",
    "error_analysis[\"RAG Prediction\"] = rag_top1\n",
    "\n",
    "error_analysis[\"BiLSTM Correct\"] = (\n",
    "    error_analysis[\"answer\"] == error_analysis[\"BiLSTM Prediction\"]\n",
    ")\n",
    "\n",
    "error_analysis[\"DistilBERT Correct\"] = (\n",
    "    error_analysis[\"answer\"] == error_analysis[\"DistilBERT Prediction\"]\n",
    ")\n",
    "\n",
    "error_analysis[\"RAG Correct\"] = (\n",
    "    error_analysis[\"answer\"] == error_analysis[\"RAG Prediction\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------\n",
    "# 3. Representative model failures\n",
    "# ----------------------------------------------------------\n",
    "\n",
    "print(\"\\nBiLSTM Failure Examples\")\n",
    "display(\n",
    "    error_analysis[~error_analysis[\"BiLSTM Correct\"]][\n",
    "        [\"prompt\", \"answer\", \"BiLSTM Prediction\"]\n",
    "    ].head(5)\n",
    ")\n",
    "\n",
    "print(\"\\nDistilBERT Failure Examples\")\n",
    "display(\n",
    "    error_analysis[~error_analysis[\"DistilBERT Correct\"]][\n",
    "        [\"prompt\", \"answer\", \"DistilBERT Prediction\"]\n",
    "    ].head(5)\n",
    ")\n",
    "\n",
    "print(\"\\nRAG Failure Examples\")\n",
    "display(\n",
    "    error_analysis[~error_analysis[\"RAG Correct\"]][\n",
