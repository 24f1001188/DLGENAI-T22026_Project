    "def predict_sentence_transformer_top3(df, model):\n",
    "    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    predictions = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "        texts = [\n",
    "            row[\"prompt\"],\n",
    "            row[\"A\"],\n",
    "            row[\"B\"],\n",
    "            row[\"C\"],\n",
    "            row[\"D\"],\n",
    "            row[\"E\"]\n",
    "        ]\n",
    "\n",
    "        embeddings = model.encode(\n",
    "            texts,\n",
    "            convert_to_numpy=True,\n",
    "            normalize_embeddings=True\n",
    "        )\n",
    "\n",
    "        prompt_embedding = embeddings[0]\n",
    "        option_embeddings = embeddings[1:]\n",
    "        \n",
    "        similarities = np.dot(option_embeddings, prompt_embedding)\n",
    "        \n",
    "        ranked_indices = np.argsort(similarities)[::-1]\n",
    "\n",
    "        top3 = [options[i] for i in ranked_indices[:3]]\n",
    "        predictions.append(top3)\n",
    "\n",
    "    return predictions"
   ]
  },
