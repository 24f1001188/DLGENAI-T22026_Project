age=\"macro\", zero_division=0\n        )\n    }","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# Common MCQ-Level Evaluation\n# ==========================================================\n\ncommon_results = []\n\ncommon_results.append(\n    evaluate_mcq_model(\n        val_df[\"answer\"],\n        bilstm_val_predictions,\n        \"BiLSTM\"\n    )\n)\n\ncommon_results.append(\n    evaluate_mcq_model(\n        val_df[\"answer\"],\n        transformer_val_predictions,\n        \"DistilBERT\"\n    )\n)\n\ncommon_results.append(\n    evaluate_mcq_model(\n        val_df[\"answer\"],\n        rag_val_predictions,\n        \"RAG\"\n    )\n)\n\ncommon_evaluation = pd.DataFrame(common_results)\n\ncommon_evaluation","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# WANDB for common evaluation","metadata":{}},{"cell_type":"code","source":"# ==========================================================\n# W&B Runs - Common MCQ-Level Model Comparison\n# ==========================================================\n\nimport wandb\n\nENTITY = \"hemalathabaskar7654-indian-institute-of-technology-madras\"\nPROJECT = \"24f1001188-t22026\"\n\n# Create one standardized evaluation run for each model\nfor _, row in common_evaluation.iterrows():\n\n    model_name = row[\"Model\"]\n\n    run = wandb.init(\n        entity=ENTITY,\n        project=PROJECT,\n        name=f\"{model_name}-MCQ-Eval\",\n        job_type=\"evaluation\",\n        tags=[\"mcq-evaluation\", \"common-metrics\", model_name.lower()],\n        notes=(\n            \"Common 5-class MCQ-level evaluation using the model's \"\n            \"Top-1 predicted answer. Metrics are calculated on the \"\n            \"same leakage-free validation split for fair comparison.\"\n        ),\n        reinit=True\n    )\n\n    # Identify what is being evaluated\n    wandb.config.upd