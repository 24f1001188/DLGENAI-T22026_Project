    "def weighted_rank_ensemble(\n",
    "    bilstm_preds,\n",
    "    transformer_preds,\n",
    "    rag_preds,\n",
    "    bilstm_weight=0.45,\n",
    "    transformer_weight=0.35,\n",
    "    rag_weight=0.20\n",
    "):\n",
    "\n",
    "    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    ensemble_predictions = []\n",
    "\n",
    "    for b_pred, t_pred, r_pred in zip(\n",
    "        bilstm_preds,\n",
    "        transformer_preds,\n",
    "        rag_preds\n",
    "    ):\n",
    "\n",
    "        scores = defaultdict(float)\n",
    "\n",
    "        # -------- BiLSTM (3 options) --------\n",
    "        for rank, option in enumerate(b_pred):\n",
    "            scores[option] += bilstm_weight * (3 - rank)\n",
    "\n",
    "        # -------- DistilBERT (Top-3) --------\n",
    "        for rank, option in enumerate(t_pred):\n",
    "            scores[option] += transformer_weight * (3 - rank)\n",
    "\n",
    "        # -------- RAG (Top-3) --------\n",
    "        for rank, option in enumerate(r_pred):\n",
    "            scores[option] += rag_weight * (3 - rank)\n",
    "\n",
    "        ranked = sorted(\n",
    "            options,\n",
    "            key=lambda x: scores[x],\n",
    "            reverse=True\n",
    "        )\n",
    "\n",
    "        ensemble_predictions.append(ranked[:3])\n",
    "\n",
    "    return ensemble_predictions"
   ]
