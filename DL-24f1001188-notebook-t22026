    "def predict_transformer_top3(df, model, tokenizer):\n",
    "\n",
    "    if hasattr(model, \"model\"):\n",
    "        model = model.model\n",
    "        \n",
    "    model.eval()\n",
    "\n",
    "    options = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "    predictions = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "\n",
    "        scores = []\n",
    "\n",
    "        for option in options:\n",
    "\n",
    "            text = row[\"prompt\"] + \" [SEP] \" + str(row[option])\n",
    "\n",
    "            inputs = tokenizer(\n",
    "                text,\n",
    "                return_tensors=\"pt\",\n",
    "                truncation=True,\n",
    "                padding=\"max_length\",\n",
    "                max_length=128\n",
    "            )\n",
    "\n",
    "            inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "\n",
    "            with torch.no_grad():\n",
    "                outputs = model(**inputs)\n",
    "\n",
    "                logits = outputs.logits\n",
    "\n",
    "                probability = torch.softmax(logits, dim=1)[0, 1].item()\n",
    "\n",
    "            scores.append(probability)\n",
    "\n",
    "        ranked = np.argsort(scores)[::-1]\n",
    "\n",
    "        predictions.append([options[i] for i in ranked[:3]])\n",
    "\n",
    "    return predictions"
   ]
  },
