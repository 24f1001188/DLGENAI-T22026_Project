\n        opt_vec = vectorizer.transform([row[opt]])\n        sim = cosine_similarity(p_vec, opt_vec)[0][0]\n        similarities[opt] = sim\n    \n    sorted_options = sorted(similarities, key=similarities.get, reverse=True)\n    top3_pred = sorted_options[:3]\n    \n    all_predictions.append(top3_pred)\n\nscores = []\n\nfor cor_ans, pred in zip(train[\"answer\"], all_predictions):\n    if cor_ans in pred:\n        score = 1 / (pred.index(cor_ans) + 1)\n    else:\n        score = 0\n    \n    scores.append(score)\n\ntfidf_map3 = sum(scores) / len(scores)\n\nprint(\"TF-IDF Pipeline MAP@3:\", tfidf_map3)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T14:14:23.174561Z","iopub.execute_input":"2026-06-22T14:14:23.174862Z","iopub.status.idle":"2026-06-22T14:14:34.773703Z","shell.execute_reply.started":"2026-06-22T14:14:23.174836Z","shell.execute_reply":"2026-06-22T14:14:34.772876Z"}},"outputs":[{"name":"stdout","text":"TF-IDF Pipeline MAP@3: 0.2961666666666667\n","output_type":"stream"}],"execution_count":50}]}